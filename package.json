{
  "name": "personal-portfolio",
  "version": "3.18.1",
  "private": true,
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev -p 3004",
    "build": "next build",
    "build:smoke": "ALLOW_BUILD_WITHOUT_SANITY=true NEXT_PUBLIC_USE_DEMO_CONTENT=true next build",
    "start": "next start -p 3004",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-default-type=module --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "budget:performance": "node scripts/performance-budget.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "check:version": "node scripts/check-version-coherence.mjs",
    "verify": "npm run check:version && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@sanity/client": "7.26.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.451.0",
    "next": "16.3.3",
    "next-sanity": "13.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.9.1",
    "styled-components": "^6.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "patch-package": "8.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@sanity/uuid": "~3.0.3",
    "@module-federation/dts-plugin": "2.8.2",
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    },
    "dompurify": "3.4.13",
    "js-yaml": "5.2.3",
    "nanoid@>=3.0.0 <3.3.17": "3.3.18",
    "@vercel/frameworks": {
      "smol-toml": "1.7.1"
    },
    "next": {
      "postcss": "^8.5.18",
      "sharp": "0.35.4"
    },
    "typeid-js": {
      "uuid": "~11.1.1"
    },
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.1"
    },
    "sharp": "0.35.4",
    "adm-zip": "0.6.1"
  },
  "license": "Apache-2.0",
  "author": "Sidakpreet Singh",
  "description": "Interactive personal portfolio with Sanity CMS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/personal-portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/impreetentious/personal-portfolio/issues"
  },
  "homepage": "https://github.com/impreetentious/personal-portfolio#readme"
}
