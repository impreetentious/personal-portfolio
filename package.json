    "lucide-react": "^0.451.0",
    "next": "16.1.6",
    "next-sanity": "12.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "5.11.0",
    "styled-components": "^6.3.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
