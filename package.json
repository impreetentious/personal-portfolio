{
  "name": "personal-portfolio",
  "version": "3.17.2",
  "private": true,
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev -p 3004",
    "build": "next build",
    "build:smoke": "ALLOW_BUILD_WITHOUT_SANITY=true NEXT_PUBLIC_USE_DEMO_CONTENT=true next build",
    "start": "next start -p 3004",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-default-type=module --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "budget:performance": "node scripts/performance-budget.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "check:version": "node scripts/check-version-coherence.mjs",
    "verify": "npm run check:version && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@sanity/client": "7.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.451.0",
    "next": "16.2.6",
    "next-sanity": "12.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanity": "5.24.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "patch-package": "8.0.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@sanity/uuid": "~3.0.2",
    "@module-federation/dts-plugin": "2.4.0",
    "minimatch@3": {
      "brace-expansion": "1.1.14"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.6"
    },
    "dompurify": "3.4.2",
    "js-yaml": "4.1.1",
    "nanoid@>=3.0.0 <3.3.12": "3.3.12",
    "@vercel/frameworks": {
      "smol-toml": "1.6.1",
      ".": "3.29.0"
    },
    "next": {
      "postcss": "^8.5.14",
      "sharp": "^0.34.5"
    },
    "typeid-js": {
      "uuid": "~11.1.1"
    }
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Interactive personal portfolio with Sanity CMS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/personal-portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/personal-portfolio/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/personal-portfolio#readme"
}
