{
  "name": "personal-portfolio",
  "version": "3.14.3",
  "private": true,
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start -p 3004",
    "lint": "eslint .",
    "format": "prettier --write .",
