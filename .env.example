NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token
NEXT_PUBLIC_SITE_URL=https://portfolio.sidakpreetsingh.com
# Keep false until the production portfolio is ready to be discoverable.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Neutral demo records are enabled automatically in development. Enable them
# explicitly only for CMS-less smoke builds and UI tests.
# NEXT_PUBLIC_USE_DEMO_CONTENT=true
# Embedded /studio is disabled unless explicitly enabled. Sanity authentication
# protects the Studio, and the
# route-scoped production CSP allows only its documented Sanity origins.
# NEXT_PUBLIC_ENABLE_STUDIO=true
# Escape hatch: `npm run build` fails without NEXT_PUBLIC_SANITY_PROJECT_ID so a
# CMS-less deploy can't ship silently. Uncomment only for intentional smoke builds.
# ALLOW_BUILD_WITHOUT_SANITY=true
