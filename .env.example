NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token
NEXT_PUBLIC_SITE_URL=https://portfolio.sidakpreetsingh.com
# Keep false until the production portfolio is ready to be discoverable.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Embedded /studio is disabled unless explicitly enabled. Leave unset/false on
# public production hosts; use Sanity's hosted Studio or project ACLs instead.
# NEXT_PUBLIC_ENABLE_STUDIO=true
# Escape hatch: `npm run build` fails without NEXT_PUBLIC_SANITY_PROJECT_ID so a
# CMS-less deploy can't ship silently (content sections would be empty — the
# placeholder fallbacks are development-only). Uncomment for intentional smoke builds.
# ALLOW_BUILD_WITHOUT_SANITY=true
